;; =======================================================================
;; Kanata Homerow Mods Configuration v1.6
;; Layout: CMAS (Ctrl, Meta, Alt, Shift) mirrored on both hands
;; -----------------------------------------------------------------------
;; clean.kbd (Apple MacBook Pro)
;; Merged from: kanata.kbd (base structure, nav layer, fn/bypass layers)
;;              ldebritto-urob.kbd (lhrm/rhrm/nomod templates, @tap RPI emulation, num/sym layers)
;; Target: macOS, full 65+ keyboard (internal + Keychron V1 Max via macos-dev-names-exclude)
;; -----------------------------------------------------------------------
;; =======================================================================

(defcfg
  process-unmapped-keys yes
  block-unmapped-keys no
  log-layer-changes no
  concurrent-tap-hold yes
  delegate-to-first-layer yes
  chords-v2-min-idle 350
  tap-hold-require-prior-idle 105
  macos-dev-names-exclude (
    "Keychron V1 Max"
    "Keychron B1 Pro"
  )
)

;; -----------------------------------------------------------------------
;; TIMINGS & POSITIONAL LISTS
;; -----------------------------------------------------------------------
(defvar
  tapping-term       210    ;; hold timeout for HRM keys
  quick-tap-ms       210    ;; tap-repress timeout (ZMK tap-repress-timeout)
  require-prior-idle 105    ;; idle window before HRM hold is allowed (ZMK require-prior-idle)
  combo-timeout      60     ;; chord activation window

  ;; Keys used for bilateral disambiguation in tap-hold-release-tap-keys-release.
  ;; Pressing a key from the opposite side while holding an HRM immediately outputs a tap.
  left-hand-keys  (grv 1 2 3 4 5 tab q w e r t g z x c v b)
  right-hand-keys (6 7 8 9 0 - = bspc y u i o p [ ] \ scln ' ret n m , . /)

  ;; Keys used for same-side rolling disambiguation (release trigger).
  ;; Releasing one of these while holding an HRM on the same hand outputs a tap.
  home-row-left-keys  (a s d f)
  home-row-right-keys (j k l scln ')
)

;; Release-order home-row mod templates.
;; A held HRM stays undecided until another key is released. If that other key
;; releases first, use the HRM as its modifier; otherwise, emit the HRM's
;; letter when it is released, even after the 300 ms grace period.
(deftemplate lhrm (tappingterm tap-key hold-key)
  (tap-hold-release-tap-keys-release $quick-tap-ms $tappingterm
    $tap-key $hold-key
    $left-hand-keys $home-row-left-keys)
)

(deftemplate rhrm (tappingterm tap-key hold-key)
  (tap-hold-release-tap-keys-release $quick-tap-ms $tappingterm
    $tap-key $hold-key
    $right-hand-keys $home-row-right-keys)
)

;; -----------------------------------------------------------------------
;; ALIASES & BEHAVIOR LOGIC
;; -----------------------------------------------------------------------
(defalias
  cw (caps-word 2000)

  ;; require-prior-idle is handled natively via tap-hold-require-prior-idle in defcfg

  ;; --- Caps Lock: tap=Esc, hold=Numpad ---
  caps_num (tap-hold-release $quick-tap-ms $tapping-term esc (layer-while-held num))

  ;; --- Spacebar: tap=space, hold=nav layer ---
  ;; Increased timeout and changed to tap-hold-release to prevent dropping spaces during fast typing
  spc_nav (tap-hold-release 200 250 spc (layer-toggle nav))

  ;; --- Tab: tap=tab, hold=Hyper ---
  tab_hyper (tap-hold-release $quick-tap-ms $tapping-term tab (multi lctl lalt lmet lsft))

  ;; --- Bilateral Symbol Layer Aliases ---
  tilde    S-grv
  at       S-2
  hash     S-3
  dollar   S-4
  percent  S-5
  lparen   S-9
  lbrace   S-[
  lbracket lbrc
  backtick grv
  excl     S-1

  caret    S-6
  amp      S-7
  asterisk S-8
  rparen   S-0
  rbrace   S-]
  rbracket rbrc

  under    S--
  plus     S-=

  ;; --- Tap-Dance Macros ---
  m_parens   (macro S-9 S-0)
  m_braces   (macro S-[ S-])
  m_brackets (macro lbrc rbrc)
  m_angles   (macro S-, S-.)

  ;; --- Tap-Dance Aliases ---
  td_j (tap-dance 250 (S-9 S-0 @m_parens))
  td_k (tap-dance 250 (S-[ S-] @m_braces))
  td_l (tap-dance 250 (lbrc rbrc @m_brackets))
  td_m (tap-dance 250 (S-, S-. @m_angles))

  ;; --- Index-finger Symbol Layer Activators ---
  g_sym (tap-hold-release $quick-tap-ms $tapping-term g (layer-while-held sym))
  h_sym (tap-hold-release $quick-tap-ms $tapping-term h (layer-while-held sym))

  ;; --- Home Row Mods (left hand): Ctrl / Cmd / Alt / Shift ---
  a_mod   (t! lhrm $tapping-term a    lctl)
  s_mod   (t! lhrm $tapping-term s    lmet)
  d_mod   (t! lhrm $tapping-term d    lalt)
  f_mod   (t! lhrm $tapping-term f    lsft)

  ;; --- Home Row Mods (right hand): Shift / Alt / Cmd / Ctrl ---
  j_mod   (t! rhrm $tapping-term j    rsft)
  k_mod   (t! rhrm $tapping-term k    ralt)
  l_mod   (t! rhrm $tapping-term l    lmet)
  sem_mod (t! rhrm $tapping-term scln rctl)

  ;; --- zfn: tap=z, hold=fn-base layer (secondary fn access from home area) ---
  zfn (t! lhrm $tapping-term z (layer-while-held fn-base))

  ;; --- Nav layer shortcuts ---
  opt_bspc (multi lalt bspc)
  opt_del  (multi lalt del)
  cmd_q    (multi lmet q)
  cmd_w    (multi lmet w)
  cmd_z    (multi lmet z)
  cmd_x    (multi lmet x)
  cmd_c    (multi lmet c)
  cmd_v    (multi lmet v)
  opt_dot  (multi lalt .)

  ;; --- F-Key Aliases ---
  mc_up   (multi lctl up)         ;; Mission Control
  app_lst f4                      ;; Applications List (Launchpad)
  mc_down (multi lctl down)       ;; App Exposé
  emoji   (multi lctl lmet spc)   ;; Emoji Picker (Recommended for F6)
  lock_sc (multi lctl lmet q)     ;; Lock Screen (Recommended for F8)

  ;; --- Sym Layer C/V Tap-Dances ---
  td_sym_c (tap-dance 250 ((multi lmet c) (multi lctl lsft c) (multi lmet lsft c)))
  td_sym_v (tap-dance 250 ((multi lmet v) (multi lctl lsft v) (multi lctl lalt lmet lsft v)))

  ;; --- Fn layer toggles ---
  fn_base (layer-toggle fn-base)
  fn_byp  (layer-toggle fn-byp)
  to_byp  (layer-switch bypass)
  to_base (layer-switch base)

  ;; --- Num layer macros ---

)

(defchordsv2
  (esc bspc) lrld $combo-timeout all-released (base nav num sym bypass fn-base fn-byp muggle)
)

;; -----------------------------------------------------------------------
;; SOURCE KEYS: 60% Keybd Layout - 77 keys in a 13/14/14/13/12/11 layout
;;
;; Explicitly defining alphas and Caps Lock for positional tracking
;; -----------------------------------------------------------------------
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    scln '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  f24  lctl lalt lmet           spc            rmet ralt
)

;; -----------------------------------------------------------------------
;; LAYERS (Base Layer HRM)
;; -----------------------------------------------------------------------
(deflayer base
  esc        brdn   brup   @mc_up @app_lst @mc_down @emoji prev   @lock_sc next   mute     vold volu
  grv        1      2      3      4        5        6      7      8        9      0        -    =    bspc
  @tab_hyper q      w      e      r        t        y      u      i        o      p        [    ]    \
  @caps_num  @a_mod @s_mod @d_mod @f_mod   @g_sym   @h_sym @j_mod @k_mod   @l_mod @sem_mod '   ret
  lsft       @zfn   x      c      v        b        n      m      ,        .      /        rsft
  @fn_base   lctl   lalt   lmet            @spc_nav        rmet   @fn_base
)

;; Temporarily active during fast typing to prevent accidental HRM hold activation.
;; All HRM keys output their tap character here, except the shift keys (F=lsft, J=rsft)
;; which stay active so you can capitalize while typing fast.
(deflayer nomods
  esc      brdn  brup  f3   f4     f5   f6   prev   pp   next  mute  vold volu
  grv      1     2     3    4      5    6    7      8    9     0     -    =    bspc
  tab      q     w     e    r      t    y    u      i    o     p     [    ]    \
  @caps_num a    s     d    @f_mod g    h    @j_mod k    l     scln  '    ret
  lsft     z     x     c    v      b    n    m      ,    .     /     rsft
  @fn_base lctl  lalt  lmet        @spc_nav         rmet ralt
)

(deflayer nav
  _    _      _      _      _      _    _     _     _     _        _    _    _
  _    _      _      _      _      _    _     _     spc   _        _    _    _    _
  _    @cmd_q @cmd_w _      _      _    _     del   up    bspc     _    _    _    _
  _    lctl   lmet   lalt   lsft   spc  home  left  down  rght     end  _    _
  _    @cmd_z @cmd_x @cmd_c @cmd_v _    pgup  pgdn  _     @opt_dot _    _
  _    _      _      _                  _                  _        _
)

;; Numpad on QWERTY row.
;; Access: hold Caps Lock.
(deflayer num
  _    f1    f2    f3   f4    f5    f6   f7   f8   f9   f10   f11   f12
  _    _     _     _    _     _     _    _    /    S-8  -     _     _     _
  _    1     2     3    4     5     6    7    8    9    S-=   _     _     _
  _    lctl  lalt  lsft lmet  _     tab  4    5    6    ret   bspc  _
  _    _     _     caps _  _  _    1    2    3    kp.   _
  _    _     _     _                0                  _     _
)

;; Symbols layer (combined).
;; Access: hold G or H.
(deflayer sym
  _         _     _    _         _         _        _      _     _         _     _ _ _
  _         _     _    _         _         _        _      _     _         _     _ _ _ _
  @backtick @excl @at  @hash     @dollar   @percent @caret @amp  @asterisk -     = _ _ _
  @tilde    lctl  lmet lalt      lsft      _        _      @td_j @td_k     @td_l _ _ _
  _         _     _    @td_sym_c @td_sym_v _        _      @td_m _         _     _ _
  _         _     _    _                   @cw             _     _
)

;; No HRM, no layer tricks. Plain keyboard passthrough.
;; Toggle via layer-switch muggle (add a shortcut or use kanata-tray to activate).
(deflayer muggle
  esc  brdn  brup  f3   f4   f5   f6   prev pp   next mute vold volu
  grv  1     2     3    4    5    6    7    8    9    0    -    =    bspc
  tab  q     w     e    r    t    y    u    i    o    p    [    ]    \
  caps a     s     d    f    g    h    j    k    l    scln '    ret
  lsft z     x     c    v    b    n    m    ,    .    /    rsft
  f24  lctl  lalt  lmet      spc       rmet ralt
)

(deflayer bypass
  esc  brdn  brup  f3   f4   f5   f6   prev pp   next  mute  vold  volu
  grv  1     2     3    4    5    6    7    8    9     0     -     =     bspc
  tab  q     w     e    r    t    y    u    i    o     p     [     ]     \
  caps a     s     d    f    g    h    j    k    l     scln  '     ret
  lsft z     x     c    v    b    n    m    ,    .     /     rsft
  @fn_byp lctl lalt lmet          spc              rmet  @fn_byp
)

(deflayer fn-base
  _    f1    f2    f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  _    _     _     _    _    _    _    _    _    _    _     _     _     _
  _    _     _     _    _    _    _    _    _    _    _     _     _     @to_byp
  _    _     _     _    _    _    _    _    _    _    _     _     _
  _    _     _     _    _    _    _    _    _    _    _     _
  _    _     _     _              _                   _     _
)

(deflayer fn-byp
  _    f1    f2    f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  _    _     _     _    _    _    _    _    _    _    _     _     _     _
  _    _     _     _    _    _    _    _    _    _    _     _     _     @to_base
  _    _     _     _    _    _    _    _    _    _    _     _     _
  _    _     _     _    _    _    _    _    _    _    _     _
  _    _     _     _              _                   _     _
)
