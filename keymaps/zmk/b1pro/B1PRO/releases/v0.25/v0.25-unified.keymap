    layer_w_nav1 {
      bindings = <
        &to LYR_W_BASE     &kp F13            &kp F14            &kp F15               &kp F16             &kp F17                &kp F18     &kp F19          &kp F20      &kp F21           &kp F22             &kp F23         &kp F24             &trans
        &trans             &trans             &trans             &kp HASH              &trans              &uc MOUSE_WHEEL_DOWN   &trans      &trans           &kp SPACE    &trans            &uc MOUSE_BUTTON_1  &uc MOUSE_UP    &uc MOUSE_BUTTON_2  &trans
        &trans             &uc LA(F4)         &uc LC(W)          &uc MOUSE_WHEEL_LEFT  &uc MOUSE_WHEEL_UP  &uc MOUSE_WHEEL_RIGHT  &uc LC(Y)   &kp DEL          &kp UP       &kp BSPC          &uc MOUSE_LEFT      &uc MOUSE_DOWN  &uc MOUSE_RIGHT     &trans
        &trans             &kp LCTRL          &kp LGUI           &kp LALT  &kp LSHFT   &kp SPACE           &kp HOME               &kp LEFT    &kp DOWN         &kp RIGHT    &kp END           &trans              &trans
        &trans             &uc LC(Z)          &uc LC(X)          &uc LC(C)  &uc LC(V)  &uc LC(B)           &kp PG_UP              &kp PG_DN   &uc LC(LS(TAB))  &uc LC(TAB)  &uc LC(LS(FSLH))  &trans
        &uc MOUSE_SPEED_1  &uc MOUSE_SPEED_2  &uc MOUSE_SPEED_3  &none                 &trans              &trans                 &kp LEFT    &kp UP           &kp DOWN     &kp RIGHT
        &none  &none  &none  &none  &none
      >;
    };

