/*
 * Keychron B1 Pro v0.25 candidate.
 * BASE Layers (0 & 6): Fn key next to R_CMD / R_ALT: 1-tap TG(FUNC), 2-tap OSL(MCRO), Hold MO(FUNC).
 * FUNC Layers (1 & 7): Numrow-6 = NumLock (KP_NUM), Numrow 7-0 = *, /, +, -, Q-T = &trans, Y = DEL, P = BSPC.
 * SYMBOL Layers (2 & 8): Fn row = F1-F12, Num row = F13-F24. Left-hand ASDF = opening <, [, {, (.
 *   Right-hand JKLM = closing ), }, ], > (1-tap) and auto-closing macros (_), {_}, [_], <_> (2-tap).
 * MACRO Layers (5 & 11): Hold Z or / activates momentary bracket macros on J, K, L, M.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define LYR_M_BASE        0
#define LYR_M_FUNC        1
#define LYR_M_SYM1        2
#define LYR_M_NAV1        3
#define LYR_M_UAT         4
#define LYR_M_MCRO        5
#define LYR_W_BASE        6
#define LYR_W_FUNC        7
#define LYR_W_SYM1        8
#define LYR_W_NAV1        9
#define LYR_W_UAT         10
#define LYR_W_MCRO        11

#define MOUSE_UP          0x00CD
#define MOUSE_DOWN        0x00CE
#define MOUSE_LEFT        0x00CF
#define MOUSE_RIGHT       0x00D0
#define MOUSE_BUTTON_1    0x00D1
#define MOUSE_BUTTON_2    0x00D2
#define MOUSE_WHEEL_UP    0x00D9
#define MOUSE_WHEEL_DOWN  0x00DA
#define MOUSE_WHEEL_LEFT  0x00DB
#define MOUSE_WHEEL_RIGHT 0x00DC
#define MOUSE_SPEED_1     0x00DD
#define MOUSE_SPEED_2     0x00DE
#define MOUSE_SPEED_3     0x00DF

/ {
    ZMK_MACRO(recover, bindings = <&out OUT_RECOVER>;)
    ZMK_MACRO(change, bindings = <&out OUT_FN>;)
    ZMK_MACRO(fn_win, bindings = <&out OUT_FN_WIN>;)
    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)
    ZMK_MACRO(mcro_parens, bindings = <&kp LPAR &kp RPAR &kp LEFT>;)
    ZMK_MACRO(mcro_braces, bindings = <&kp LBRC &kp RBRC &kp LEFT>;)
    ZMK_MACRO(mcro_brackets, bindings = <&kp LBKT &kp RBKT &kp LEFT>;)
    ZMK_MACRO(mcro_angle_brackets, bindings = <&kp LT &kp GT &kp LEFT>;)

    /*
     * Factory Reset Hold-Tap (3-second guard):
     * Invokes &recover (&out OUT_RECOVER -> zmk_factory_recover()).
     * Erases stored Bluetooth bonds from NVS, deletes dynamic VIA/EEPROM overrides,
     * resets internal runtime flags (e.g. fn_exchange), flashes recovery LED,
     * and restarts the MCU back into the compiled v0.25 candidate baseline.
     */
    long_press_recover: long_press_recover {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_RECOVER";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&recover>, <&none>;
    };

    /*
     * Function/Media Row Exchange Hold-Tap (3-second guard):
     * Invokes &change (&out OUT_FN -> do_f1_f13_fn_exchange()).
     */
    long_press_change: long_press_change {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_CHANGE";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&change>, <&none>;
    };

    /*
     * Windows Key Lock Hold-Tap (3-second guard):
     * Invokes &fn_win (&out OUT_FN_WIN -> toggles fn_win_lock flag).
     * When active, hid.c filters out LGUI/RGUI modifier signals globally across
     * all Windows layers (Base 6, Sym 8, Nav 9, Macro 11) to prevent accidental
     * Win+L, Win+U, or gaming interruptions.
     */
    long_press_fn_win: long_press_fn_win {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_FN_WIN";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&fn_win>, <&none>;
    };

    /*
     * Fn + Esc dual-role bindings for Function layers (pos 0):
     * - Tap: Instantly exits Function layer back to Base (Layer 0 Mac / Layer 6 Win).
     * - Hold (3s): Toggles Function/Media row exchange (&change / OUT_FN).
     */
    fn_esc_change_mac: fn_esc_change_mac {
        compatible = "zmk,behavior-hold-tap";
        label = "FN_ESC_CHANGE_MAC";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&change>, <&to>;
    };

    fn_esc_change_win: fn_esc_change_win {
        compatible = "zmk,behavior-hold-tap";
        label = "FN_ESC_CHANGE_WIN";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&change>, <&to>;
    };

    long_press_bootloader: long_press_bootloader {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_BOOTLOADER";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&en_bootloader>, <&none>;
    };

    esc_caps: escape_caps_lock {
        compatible = "zmk,behavior-hold-tap";
        label = "ESC_CAPS_LOCK";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <600>;
        // Use an ordinary press/release for the hold. &kt keeps CLCK down
        // across physical releases, which requires a second hold to finish.
        bindings = <&kp>, <&kp>;
    };

    ht_fn_mac: ht_fn_mac {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_FN_MAC";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&tog>;
    };

    td_fn_mac: td_fn_mac {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_FN_MAC";
        #binding-cells = <1>;
        tapping-term-ms = <250>;
        bindings = <&ht_fn_mac LYR_M_FUNC LYR_M_FUNC>, <&sl LYR_M_MCRO>;
    };

    ht_fn_win: ht_fn_win {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_FN_WIN";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&tog>;
    };

    td_fn_win: td_fn_win {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_FN_WIN";
        #binding-cells = <1>;
        tapping-term-ms = <250>;
        bindings = <&ht_fn_win LYR_W_FUNC LYR_W_FUNC>, <&sl LYR_W_MCRO>;
    };

    td_bt_0: td_bt_0 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_BT_0";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&bt BT_SEL 0>, <&bt BT_PAIR 0>;
    };

    td_bt_1: td_bt_1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_BT_1";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&bt BT_SEL 1>, <&bt BT_PAIR 1>;
    };

    td_bt_2: td_bt_2 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_BT_2";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&bt BT_SEL 2>, <&bt BT_PAIR 2>;
    };

    td_sym_parens: td_sym_parens {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_PARENS";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp RPAR>, <&mcro_parens>;
    };

    td_sym_braces: td_sym_braces {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_BRACES";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp RBRC>, <&mcro_braces>;
    };

    td_sym_brackets: td_sym_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_BRACKETS";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp RBKT>, <&mcro_brackets>;
    };

    td_sym_angle_brackets: td_sym_angle_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_ANGLE_BRACKETS";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp GT>, <&mcro_angle_brackets>;
    };

    td_nav_c_mac: td_nav_c_mac {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_NAV_C_MAC";
        #binding-cells = <1>;
        tapping-term-ms = <200>;
        bindings = <&uc LG(C)>, <&uc LG(LS(C))>, <&uc LC(LS(C))>;
    };

    td_nav_v_mac: td_nav_v_mac {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_NAV_V_MAC";
        #binding-cells = <1>;
        tapping-term-ms = <200>;
        bindings = <&uc LG(V)>, <&uc LC(V)>, <&uc LC(LS(V))>;
    };

    lhm: left_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "LEFT_HOMEROW_MODS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <
            7 8 9 10 11 12
            20 21 22 23 24 25 26
            34 35 36 37 38 39 40
            47 48 49 50 51 52 53
            60 61 62 63 64 65
            70 71 72 73 74 75
        >;
        bindings = <&kp>, <&kp>;
    };

    rhm: right_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "RIGHT_HOMEROW_MODS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <
            0 1 2 3 4 5 6
            13 14 15 16 17 18 19
            27 28 29 30 31 32 33
            41 42 43 44 45 46
            54 55 56 57 58 59
            66 67 68 69
        >;
        bindings = <&kp>, <&kp>;
    };


    uc: user_custom {
        compatible = "zmk,behavior-key-press";
        label = "USER_CUSTOM";
        #binding-cells = <1>;
    };

    combos {
        compatible = "zmk,combos";

        /*
         * Factory Reset Chord (Fn + J + Z held for 3 seconds):
         * - Scoped strictly to Function layers (<LYR_M_FUNC LYR_W_FUNC>), leaving
         *   individual J and Z keys completely unrestricted across Base and other layers.
         * - Simultaneous chord of J (pos 49) + Z (pos 56) with 3000ms hold guard.
         * - Executes zmk_factory_recover(): wipes all paired Bluetooth bonds in NVS,
         *   erases dynamic VIA/EEPROM customizations, resets internal flags, flashes
         *   recovery LED, and restarts the keyboard into the compiled v0.25 baseline.
         */
        combo_jz_reset {
            timeout-ms = <1000>;
            layers = <LYR_M_FUNC LYR_W_FUNC>;
            key-positions = <49 56>; /* J (49), Z (56) */
            bindings = <&long_press_recover 0 0>;
        };

        /*
         * Battery Level Query (Fn + B on Function layers):
         * - Active on Function layers (<LYR_M_FUNC LYR_W_FUNC>) at key B (pos 60).
         * - Invokes led_bat_display() to read bt_bas_get_battery_level():
         *     >= 70% : Solid Green
         *     30%-69%: Solid Blue
         *     < 30%  : Solid Red
         * - Releasing key restores normal LED state.
         */
        combo_battery {
            timeout-ms = <1000>;
            layers = <LYR_M_FUNC LYR_W_FUNC>;
            key-positions = <60>;    /* B (60) */
            bindings = <&out OUT_BAT>;
        };

        /*
         * Windows Key Lock (Fn + Win held for 3 seconds):
         * - Toggle trigger scoped to Windows Function layer (<LYR_W_FUNC>) at pos 68.
         * - Once toggled ON, the lock operates globally across all Windows layers
         *   (Base 6, Sym 8, Nav 9, Macro 11) by having hid.c suppress LGUI/RGUI signals,
         *   preventing accidental Win+L (Lock Screen), Win+U (Accessibility), or gaming interruptions.
         * - Toggling again turns the lock off.
         */
        combo_win_lock {
            timeout-ms = <1000>;
            layers = <LYR_W_FUNC>;
            key-positions = <68>;    /* Win/Alt (68) */
            bindings = <&long_press_fn_win 0 0>;
        };
    };

    keymap {

    /*
                              ..'
                      ,xNMM.
                    .OMMMMo
                    lMM"
          .;loddo:.  .olloddol;.
        cKMMMMMMMMMMNWMMMMMMMMMM0:
      .KMMMMMMMMMMMMMMMMMMMMMMMWd.
      XMMMMMMMMMMMMMMMMMMMMMMMX.
      ;MMMMMMMMMMMMMMMMMMMMMMMM:
      :MMMMMMMMMMMMMMMMMMMMMMMM:
      .MMMMMMMMMMMMMMMMMMMMMMMMX.
      kMMMMMMMMMMMMMMMMMMMMMMMMWd.
      'XMMMMMMMMMMMMMMMMMMMMMMMMMMk
        'XMMMMMMMMMMMMMMMMMMMMMMMMK.
          kMMMMMMMMMMMMMMMMMMMMMMd
          ;KMMMMMMMWXXWMMMMMMMk.
            "cooc*"    "*coo'"
                                      */
    compatible = "zmk,keymap";
    /* LAYER 0: LYR_M_BASE
    ┏━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━┓
    ┃           ┃         ┃         ┃ MISSION ┃   MAC   ┃  SEARCH ┃ CTRL+ALT┃ PREVIOUS┃ PLAY/   ┃   NEXT  ┃   Vol   ┃         ┃         ┃        ┃
    ┃TAP: ESC   ┃ Bright- ┃ Bright+ ┃ CONTROL ┃ LAUNCH  ┃         ┃    + M  ┃  TRACK  ┃  PAUSE  ┃  TRACK  ┃   Mute  ┃   Vol-  ┃  Vol+   ┃   DEL  ┃
    ┃HOLD: CAPS ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃        ┃
    ┣━━━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━━━━┫
    ┃   ~   ┃    !    ┃    @    ┃    #    ┃    $    ┃    %    ┃    ^    ┃    *    ┃    -    ┃    (    ┃    )    ┃    _    ┃    +    ┃            ┃
    ┃   `   ┃    1    ┃    2    ┃    3    ┃    4    ┃    5    ┃    6    ┃    7    ┃    8    ┃    9    ┃    0    ┃    -    ┃    =    ┃    BKSP    ┃
    ┃       ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃            ┃
    ┣━━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━━━━┫
    ┃TAP: TAB  ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃    {    ┃    }    ┃    |    ┃
    ┃HOLD: HYPR┃    Q    ┃    W    ┃    E    ┃    R    ┃    T    ┃    Y    ┃    U    ┃    I    ┃    O    ┃    P    ┃    [    ┃    ]    ┃    \    ┃
    ┃          ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃
    ┣━━━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻━━━━━━━━━┫
    ┃TAP=ESC    ┃ TAP=A   ┃ TAP=S   ┃ TAP=D   ┃ TAP=F   ┃ TAP=G   ┃ TAP=H   ┃ TAP=J   ┃ TAP=K   ┃ TAP=L   ┃ TAP=;/: ┃    "    ┃                  ┃
    ┃HOLD:MO(1) ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃    '    ┃      RETURN      ┃
    ┃           ┃  L_CTRL ┃  L_GUI  ┃  L_ALT  ┃ L_SHIFT ┃   MO(2) ┃   MO(2) ┃ R_SHIFT ┃  R_ALT  ┃  R_GUI  ┃  R_CTRL ┃         ┃                  ┃
    ┣━━━━━━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━━━━━━━━━━━━━━━━━┫
    ┃              ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃    <    ┃    >    ┃    ?    ┃                         ┃
    ┃   L_SHIFT    ┃    Z    ┃    X    ┃    C    ┃    V    ┃    B    ┃   N     ┃    M    ┃    ,    ┃    .    ┃    /    ┃        R_SHIFT          ┃
    ┃              ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃                         ┃
    ┣━━━━━━━━━━━┳━━┻━━━━━━━┳━┻━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━┻━━━━┳━━━━┻━━━━━┳━┳━┻━━━━━━┳━━━━━━━━━┳━━━━━━━━┫
    ┃           ┃          ┃           ┃                                                 ┃              ┃1T: TG(1) ┃ ┃        ┃    ↑    ┃        ┃
    ┃  L_CTRL   ┃  L_ALT   ┃   L_CMD   ┃             * &lt LYR_M_NAV1 SPACE *            ┃    R_CMD     ┃2T: OSL(5)┃ ┃    ←   ┣━━━━━━━━━┫   →    ┃
    ┃           ┃          ┃           ┃                                                 ┃              ┃HOLD:MO(1)┃ ┃        ┃    ↓    ┃        ┃
    ┗━━━━━━━━━━━┻━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━┻━━━━━━━━━━┛ ┗━━━━━━━━┻━━━━━━━━━┻━━━━━━━━┛
    */

    layer_m_base {
      bindings = <
        //ESC                     //f1                   //f2                  //f3                               //f4                 //f5              //f6              //f7            //f8              //f9        //f10            //f11              //f12            //DEL
        &esc_caps CLCK ESC        &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_MAC_LAUNCH  &kp C_AC_SEARCH   &kp C_AL_LOCK     &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp DEL
        &kp GRAVE                 &kp N1                 &kp N2                &kp N3                             &kp N4               &kp N5            &kp N6            &kp N7          &kp N8            &kp N9      &kp N0           &kp MINUS          &kp EQUAL        &kp BSPC
        &mt LC(LS(LG(LALT))) TAB  &kp Q                  &kp W                 &kp E                              &kp R                &kp T             &kp Y             &kp U           &kp I             &kp O       &kp P            &kp LBKT           &kp RBKT         &lt LYR_M_NAV1 BSLH
        &lt LYR_M_FUNC ESC        &lhm LCTRL A           &lhm LGUI S           &lhm LALT D                        &lhm LSHFT F         &lt LYR_M_SYM1 G  &lt LYR_M_SYM1 H  &rhm RSHFT J    &rhm RALT K       &rhm RGUI L &rhm RCTRL SEMI  &kp SQT            &kp RET
        &kp LSHFT                 &lt LYR_M_MCRO Z       &kp X                 &kp C                              &kp V                &kp B             &kp N             &kp M           &kp COMMA         &kp DOT     &lt LYR_M_MCRO FSLH  &kp RSHFT
        &kp LCTRL                 &uc LALT               &uc LCMD              &lt LYR_M_NAV1 SPACE                                    &uc RCMD          &td_fn_mac 0                      &kp LEFT          &kp UP      &kp DOWN         &kp RIGHT
        &mo LYR_W_BASE            &out OUT_BLE           &out OUT_24G          &out OUT_CHG                       &out OUT_CHGD
      >;
    };

    /* LAYER 1: LYR_M_FUNC
