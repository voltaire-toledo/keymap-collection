        &none           &none   &none   &none   &none   &none   &none   &none   &none   &none
        &none           &none   &none   &none   &none
      >;
    };

    /* WINDOWS LAYER 11: LYR_W_MCRO — physical binding illustration
     * [Esc] returns to W base. [1 2 3 4] persistently select W Func/Sym/Nav/UAT.
     * Every remaining physical key, including all five direct controls, is inert.
     */
    layer_w_mcro {
      bindings = <
        &to LYR_W_BASE  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
        &none           &to LYR_W_FUNC  &to LYR_W_SYM1  &to LYR_W_NAV1  &to LYR_W_UAT  &none  &none  &none  &none  &none  &none  &none  &none  &none
        &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
        &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
        &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
        &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
        &none  &none  &none  &none  &none
      >;
    };
  };
